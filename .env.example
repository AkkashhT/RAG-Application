# ── LocalRAG Environment Configuration ─────────────────────────────────────
# Copy this file to .env and adjust as needed.
# Lines starting with # are comments.

# ── Ollama ──────────────────────────────────────────────────────────────────
# URL used by the backend container to reach Ollama.
# Docker default: http://ollama:11434
# Apple Silicon (Ollama running natively on host): http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434

# VRAM tiers:
#   < 10 GB  → qwen3:8b
#   10-18 GB → qwen3:14b   (default)
#   24 GB+   → qwen3:27b
OLLAMA_GENERATION_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Reranker ─────────────────────────────────────────────────────────────────
# Set to "cpu" for CPU-only mode or Apple Silicon
RERANKER_DEVICE=cuda

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents

# ── Retrieval ────────────────────────────────────────────────────────────────
# NOTE: 0.4 is a starting point — run `make eval-calibrate` after loading
# your real documents to find the right value for your corpus.
CONFIDENCE_THRESHOLD=0.4
RERANKER_INITIAL_TOP_K=20
RERANKER_TOP_K=5

# Weight for dense vectors in RRF fusion (sparse BM25 weight = 1 - this)
HYBRID_DENSE_WEIGHT=0.6

# ── Chunking ─────────────────────────────────────────────────────────────────
# Changes here require re-indexing all documents.
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# ── Generation ───────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── Concurrency ──────────────────────────────────────────────────────────────
# Keep at 1 for a single GPU. Increase to 2 only with 24+ GB VRAM.
MAX_CONCURRENT_LLM_CALLS=1

# ── Router ───────────────────────────────────────────────────────────────────
# auto | docs | sql | both
ROUTER_MODE=auto

# ── SECURITY: these must NEVER be set — assert_no_cloud_keys() will hard-fail
# at startup if any of these are present in the environment.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=
